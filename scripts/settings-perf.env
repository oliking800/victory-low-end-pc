# 8 GB NVIDIA performance profile, measured on a newer VIctory tree.
#
# Used by the sandboxed Linux runner:
#   SETTINGS=scripts/settings-perf.env scripts/run.sh 420
#
# The target was a stable, sharp 720p image on an 8 GB RTX card:
# 1280x720 output, 0.667 render scale, 1.5 GB card-side title buffers with a
# 64 KiB floor, 1.5 GB of texture copies, BAR/CPU-mapped windows, and the
# frame-critical threads kept on the fast CPU cores.
#
# Keys marked (newer fork) are read by the newer 8 GB tree and ignored by the
# older vendored tree; they are kept here so the profile carries over.

# --- Output and pacing -------------------------------------------------------
: "${VICTORY_DISPLAY_MODE:=1280x720}"
: "${VICTORY_WINDOW_MAX:=1280x720}"
: "${VICTORY_RENDER_SCALE:=0.667}"          # (newer fork)
: "${VICTORY_OWN_UPSCALER:=1}"              # (newer fork)

# --- Card-side memory --------------------------------------------------------
: "${VICTORY_CARD_BUFFERS_MB:=1536}"
: "${VICTORY_CARD_BUFFERS_MIN_KB:=64}"      # every title buffer goes to the card
: "${VICTORY_CARD_WINDOWS_MB:=0}"           # windows use the BAR path below
: "${VICTORY_TEXTURE_BUDGET_MB:=1536}"
: "${VICTORY_TEXTURE_ROOM_PERCENT:=88}"
: "${VICTORY_WINDOWS_BAR_MB:=3072}"
: "${VICTORY_WINDOWS_BAR_PERCENT:=88}"
: "${VICTORY_WINDOW_KB:=256}"
: "${VICTORY_WINDOW_TAILS:=1}"
: "${VICTORY_SEND_KEPT_MB:=512}"            # (newer fork)
: "${VICTORY_DYNAMIC_SLOTS:=524288}"
: "${VICTORY_TEXTURE_MIP_DROP:=1}"
: "${VICTORY_LEVELS_ON_DEMAND:=1}"
: "${VICTORY_STAGING_KEPT:=4}"
: "${VICTORY_MAX_PRELUDES:=32}"

# --- CPU scheduling and diagnostics -----------------------------------------
: "${VICTORY_MAP_THREADS:=4}"
: "${VICTORY_FAST_CORES:=3}"
: "${VICTORY_TITLE_PRIORITIES:=1}"
: "${VICTORY_PANEL:=0}"
: "${VICTORY_D3D12_DRED:=0}"
: "${VICTORY_CARD_ACCOUNTING:=0}"
: "${VICTORY_PIPELINE_BOOK:=0}"
: "${VICTORY_MEMORY_MAP:=0}"

# --- The measured base around those -----------------------------------------
: "${VICTORY_AMBIENT:=1.0}"
: "${VICTORY_AMBIENT_AIR:=1.5}"
# Known-broken pipelines (water/heat haze and decal-heap defrag) are skipped
# rather than drawn black.
: "${VICTORY_SKIP_PIPELINES:=02384a60fda6f2d0,731a39171b568298}"
: "${VICTORY_CARD_AWAKE:=1}"
: "${VICTORY_CARD_REHASH_RUNS:=1}"
: "${VICTORY_CARD_STEPS:=2}"
: "${VICTORY_JOIN_COPIES:=1}"
: "${VICTORY_INDIRECT_BATCH:=2}"
: "${VICTORY_INDIRECT_WINDOW:=1}"
: "${VICTORY_RELAY:=2}"
: "${VICTORY_RELAY_COPY:=1}"
: "${VICTORY_TEXTURE_NO_WAIT:=1}"
: "${VICTORY_WIDE_BACK:=1}"
: "${VICTORY_RAW_VIEWS:=0}"
: "${VICTORY_GROUP_SYNC:=2}"
# Leave VICTORY_WAVE_LOCAL unset: `idiom` refuses the half-wave fallback and
# drops shaders on RTX (black or missing effects).
: "${VICTORY_WAVE_WIDE:=}"
: "${VICTORY_LOG:=info}"
