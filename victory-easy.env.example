# victory-easy.env
#
# Copy this file to `victory-easy.env` (next to it) and set GAME.
# That is the only required edit. The launcher fills the rest in.
#
#   copy victory-easy.env.example victory-easy.env
#   notepad victory-easy.env
#   victory-easy.cmd
#
# Choose how the runner starts. `auto` uses your detected VRAM:
#   <= 6 GB -> performance, 6-12 GB -> balanced, >= 12 GB -> quality
PROFILE=auto

# Your own copy of the title's executable.
GAME=D:\path\to\game_scarlett_master.exe

# Leave blank to use cool_fox\target\x86_64-pc-windows-msvc\release\victory.exe
# EXE=

# Leave blank to use the profile's value.
# RESOLUTION=1280x720
# RENDER_SCALE=0.667
# QUALITY=sharp

# series-s (default) or series-x (slower, larger console profile).
CONSOLE=series-s

# 1 shows the in-game overlay (F9 toggles it anyway); 0 keeps it off.
PANEL=0

# 1 writes debug logs (diagnostics build only); 0 keeps the log at info.
DEBUG_LOG=0

# Testing helpers: skip the opening with the title's own -skipToIIS switch,
# and/or hold Enter through the menus. Leave both 0 for normal play.
# SKIP_INTRO=0
# AUTO_ENTER=0

# Override hardware detection only if it guesses wrong.
# VRAM_GB=8
# RAM_GB=32

# Advanced: any VICTORY_* line overrides the selected profile.
# VICTORY_CARD_BUFFERS_MB=1536
# VICTORY_FAST_CORES=3
